NODE_ENV=production
PORT=4000
# MySQL 8 (ou MariaDB 10.6+)
DATABASE_URL=mysql://live_companion:motdepasse@localhost:3306/live_companion
# 32 caractères minimum. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Origines autorisées (interface web), séparées par des virgules
CORS_ORIGIN=*
# Inscription libre des vendeurs (false pour la fermer)
ALLOW_SIGNUP=true
