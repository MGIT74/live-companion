{
  "name": "live-companion",
  "private": true,
  "version": "0.1.0",
  "description": "Live Companion Madagascar — régie de Live Commerce Facebook (PoC Meta)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "poc/*"
  ],
  "scripts": {
    "poc": "npm run dev --workspace poc/meta-validation",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web": "npm run dev -w apps/web",
    "api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}
