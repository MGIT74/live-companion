# --- Application Meta (developers.facebook.com > Mes apps) ---
META_APP_ID=
META_APP_SECRET=
# Version de la Graph API
META_GRAPH_VERSION=v25.0
# Optionnel : si votre app utilise "Facebook Login for Business", mettez l'ID de configuration.
# Laissé vide, la PoC demande les permissions avec le paramètre "scope".
META_LOGIN_CONFIG_ID=

# --- Serveur PoC ---
PORT=3000
# URL publique HTTPS (tunnel cloudflared/ngrok ou VPS). Sert au callback OAuth et aux webhooks.
BASE_URL=https://votre-tunnel.trycloudflare.com
# Jeton libre de votre choix, à recopier dans la configuration Webhooks de l'app Meta.
WEBHOOK_VERIFY_TOKEN=change-moi
# Clé de chiffrement des jetons (64 caractères hex). Générer : npm run keygen -w poc/meta-validation
ENCRYPTION_KEY=
# Mot de passe d'accès au tableau de bord PoC (Basic Auth, utilisateur "admin")
DASHBOARD_PASSWORD=change-moi
